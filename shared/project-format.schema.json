{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baziche.app/schemas/project-format-v1.json",
  "title": "Baziche Project Format v1",
  "description": "Single source of truth for a user game. Interpreted by :runtime (preview + exported game).",
  "type": "object",
  "required": ["formatVersion", "meta", "settings", "scenes", "objects", "events", "variables", "assets"],
  "properties": {
    "formatVersion": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["name", "gameType"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gameType": { "type": "string", "minLength": 1, "maxLength": 32 },
        "packageName": { "type": "string", "maxLength": 128 },
        "versionCode": { "type": "integer", "minimum": 1 },
        "versionName": { "type": "string", "maxLength": 32 },
        "orientation": { "enum": ["portrait", "landscape", "sensor"] },
        "templateId": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "locale": { "type": "string", "maxLength": 8, "default": "fa" },
        "fps": { "type": "integer", "enum": [30, 60] }
      }
    },
    "scenes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "name": { "type": "string", "maxLength": 80 },
          "entry": { "type": "boolean" },
          "background": { "type": "object" },
          "objectIds": { "type": "array", "items": { "type": "string" }, "maxItems": 2000 },
          "transitions": { "type": "array", "maxItems": 100, "items": { "type": "object" } }
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "sceneId", "kind"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "sceneId": { "type": "string", "maxLength": 64 },
          "kind": { "type": "string", "maxLength": 32 },
          "components": {
            "type": "object",
            "description": "componentName -> component data (see shared/registries/components.json)",
            "maxProperties": 25
          },
          "visible": { "type": "boolean" },
          "layer": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "trigger", "actions"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "trigger": { "type": "object" },
          "conditions": { "type": "array", "maxItems": 50, "items": { "type": "object" } },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["capability"],
              "properties": {
                "capability": { "type": "string", "pattern": "^CAP-[0-9]{4}$" },
                "params": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "maxLength": 64 },
          "type": { "enum": ["number", "string", "bool"] },
          "initial": {},
          "persist": { "type": "boolean" }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "kind", "hash"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "kind": { "enum": ["image", "audio", "font", "video", "other"] },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "audio": { "type": "object" },
    "animations": { "type": "array", "maxItems": 1000, "items": { "type": "object" } },
    "levels": { "type": "array", "maxItems": 1000, "items": { "type": "object" } },
    "ui": { "type": "object" },
    "systems": { "type": "object" },
    "monetization": { "type": "object" },
    "build": {
      "type": "object",
      "properties": {
        "applicationId": { "type": "string", "maxLength": 128 },
        "appName": { "type": "object" },
        "versionCode": { "type": "integer", "minimum": 1 },
        "versionName": { "type": "string", "maxLength": 32 },
        "targetApi": { "type": "integer", "minimum": 26, "maximum": 40 },
        "minApi": { "type": "integer", "minimum": 21, "maximum": 36 },
        "icon": { "type": "string" },
        "orientation": { "enum": ["portrait", "landscape", "sensor"] },
        "permissions": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
        "signing": { "enum": ["platform-managed", "custom"] },
        "billingProvider": { "type": ["string", "null"] },
        "adsProvider": { "type": ["string", "null"] }
      }
    }
  }
}
