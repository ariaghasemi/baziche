# Baziche — root gitignore
# NEVER commit: secrets, keystores, local env, build outputs

# --- secrets & local env ---
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
google-services.json
**/secrets/
secrets/

# --- node / backend ---
node_modules/
backend/.dev.vars
backend/.wrangler/
backend/dist/
*.log
npm-debug.log*

# --- android ---
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/*.iml
.idea/
*.hprof
.DS_Store

# --- misc ---
coverage/
.vscode/
*.swp
